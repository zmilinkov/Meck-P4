+    int8_t Sx126x::get_rssi_inst(void)
+    {
+        uint8_t buffer[2] = {0};
+
+        check_busy();
+        if (_bus->read(static_cast<uint8_t>(Cmd::RO_GET_RSSI_INST), buffer, 2) == false)
+        {
+            assert_log(Log_Level::CHIP, __FILE__, __LINE__, "read fail\n");
+            return 0;
+        }
+
+        // RssiInst = -raw / 2 dBm; clamp so a valid reading is never 0
+        int value = -static_cast<int>(buffer[1]) / 2;
+        if (value >= 0) value = -1;
+        return static_cast<int8_t>(value);
+    }
